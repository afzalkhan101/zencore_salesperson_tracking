{
  "expo": {
    "name": "ZenCore Field",
    "slug": "zencore-field",
    "scheme": "zencorefield",
    "version": "1.4.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/zencore-field-app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zencore.field",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.zencore.field",
      "versionCode": 2,
      "edgeToEdgeEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E8F8ED",
        "foregroundImage": "./assets/zencore-field-app-icon.png"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ZenCore Field collects location during an employee-started tracking session, including in the background.",
          "locationWhenInUsePermission": "Allow location to record your visit and route while tracking.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach visit photos and expense receipts.",
          "cameraPermission": "Take a photo for customer visit evidence."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "78de4691-b02a-4d26-88f9-9d65e1dd5849"
      }
    },
    "owner": "afzalkhan101"
  }
}
