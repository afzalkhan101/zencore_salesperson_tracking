<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salesperson_customer_report_wizard_form" model="ir.ui.view">
        <field name="name">salesperson.customer.report.wizard.form</field>
        <field name="model">salesperson.customer.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Visit Report" create="0" edit="1" class="o_zc_report_wizard">
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="o_zc_report_hero o_zc_customer_report_hero">
                        <div>
                            <span class="o_zc_report_eyebrow">ZENCORE FIELD / CUSTOMER ANALYTICS</span>
                            <h1>Customer Visit Report</h1>
                            <p>Review planned visits, completed meetings and field activity by customer.</p>
                        </div>
                        <span class="o_zc_report_hero_icon fa fa-users" aria-label="Customer visit report" title="Customer visit report"/>
                    </div>
                    <div class="o_zc_report_section_intro">
                        <span class="o_zc_report_section_number">01</span>
                        <div>
                            <h2>Build your report</h2>
                            <p>Choose a period and the authorised customer activity you want to review.</p>
                        </div>
                    </div>
                    <group class="o_zc_report_filter_grid" col="2">
                        <group string="Report period" class="o_zc_report_filter_group">
                            <field name="report_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="month_date" invisible="report_type != 'monthly'"/>
                            <field name="week_start" invisible="report_type != 'weekly'"/>
                            <field name="period_preset" invisible="report_type not in ('individual', 'multiple')"/>
                            <field name="date_from" readonly="report_type in ('monthly', 'weekly') or (report_type in ('individual', 'multiple') and period_preset != 'custom')"/>
                            <field name="date_to" readonly="report_type in ('monthly', 'weekly') or (report_type in ('individual', 'multiple') and period_preset != 'custom')"/>
                        </group>
                        <group string="Scope &amp; filters" class="o_zc_report_filter_group">
                            <field name="individual_user_id" options="{'no_create': True}" invisible="report_type != 'individual'" required="report_type == 'individual'"/>
                            <field name="salesperson_scope" invisible="report_type == 'individual'"/>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}" invisible="report_type == 'individual' or salesperson_scope == 'all'" required="report_type == 'multiple' and salesperson_scope == 'selected'"/>
                            <field name="customer_scope"/>
                            <field name="partner_id" options="{'no_create': True}" invisible="customer_scope == 'all'" required="customer_scope == 'selected'"/>
                            <field name="visit_status"/>
                            <field name="visit_purpose"/>
                            <field name="tracking_status"/>
                        </group>
                    </group>
                    <div class="o_zc_report_actions">
                        <button name="action_preview_pdf" type="object" string="Generate report" class="btn-primary" icon="fa-search"/>
                        <button name="action_reset" type="object" string="Reset filters" class="btn-secondary" icon="fa-refresh"/>
                        <span class="o_zc_report_action_hint">Results use only the customers and users you are allowed to monitor.</span>
                        <button name="action_export_excel" type="object" string="Export Excel" class="btn-success ms-auto" icon="fa-file-excel-o"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_salesperson_customer_report" model="ir.actions.act_window">
        <field name="name">Customer Visit Report</field>
        <field name="res_model">salesperson.customer.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_salesperson_customer_reports" name="Customer Reports" parent="menu_salesperson_reports_root" sequence="35" groups="zencore_salesperson_tracking.group_salesperson_ceo,zencore_salesperson_tracking.group_salesperson_manager,zencore_salesperson_tracking.group_salesperson_supervisor"/>
    <menuitem id="menu_salesperson_customer_detailed_report" name="Customer Visit Report" parent="menu_salesperson_customer_reports" action="action_salesperson_customer_report" sequence="10" groups="zencore_salesperson_tracking.group_salesperson_ceo,zencore_salesperson_tracking.group_salesperson_manager,zencore_salesperson_tracking.group_salesperson_supervisor"/>
</odoo>
