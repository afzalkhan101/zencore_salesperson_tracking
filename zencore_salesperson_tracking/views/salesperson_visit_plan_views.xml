<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_salesperson_visit_plan_form" model="ir.ui.view">
        <field name="name">salesperson.visit.plan.form</field>
        <field name="model">salesperson.visit.plan</field>
        <field name="arch" type="xml">
            <form string="Visit Plan">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="not zc_can_approve" groups="zencore_salesperson_tracking.group_salesperson_supervisor,zencore_salesperson_tracking.group_salesperson_manager,zencore_salesperson_tracking.group_salesperson_ceo"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="not zc_can_approve" groups="zencore_salesperson_tracking.group_salesperson_supervisor,zencore_salesperson_tracking.group_salesperson_manager,zencore_salesperson_tracking.group_salesperson_ceo"/>
                    <!-- Reset to Draft: blocked once an approved plan's visit_date has
                         arrived (today) — that day's plan is already actionable/live,
                         so pulling it back to draft would orphan a tracker mid-flow.
                         Still allowed for a future-dated approved plan (nothing started
                         yet). Re-drafting always requires going through
                         Draft -> Submit -> Approve again, unchanged. -->
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state in ('draft','cancelled') or (state == 'approved' and not is_future_visit) or state in ('in_progress','completed')"/>
                    <button name="action_reassign_direct_approver" string="Assign Direct Approver"
                            type="object" invisible="state != 'submitted'" groups="base.group_system"/>
                    <button name="action_print_visit_plan" string="Print" type="object" class="btn-secondary" groups="zencore_salesperson_tracking.group_salesperson_ceo,zencore_salesperson_tracking.group_salesperson_manager,zencore_salesperson_tracking.group_salesperson_supervisor"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,in_progress,completed"/>
                    <field name="can_start_tracking" invisible="1"/>
                    <field name="zc_can_approve" invisible="1"/>
                    <field name="is_future_visit" invisible="1"/>
                </header>
                <sheet>
                    <!-- On Track: replaces the old "Start Tracking" header button.
                         Salesman-role only (groups attr) and only for the plan's own
                         assigned salesman, only once approved, and only once the
                         visit date has actually arrived — a future-dated approved plan
                         has nothing to track yet, so it's intentionally not clickable
                         until that day (is_future_visit flips off automatically). -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_on_track" type="object" class="oe_stat_button" icon="fa-bullseye"
                                invisible="state != 'approved' or not can_start_tracking or is_future_visit"
                                groups="zencore_salesperson_tracking.group_salesperson_salesman,zencore_salesperson_tracking.group_salesperson_supervisor,zencore_salesperson_tracking.group_salesperson_manager,zencore_salesperson_tracking.group_salesperson_ceo">
                            <div class="o_stat_info">
                                <span class="o_stat_text">On Track</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group string="Basic Information">
                        <group>
                            <field name="user_id" required="1"/>
                            <field name="visit_date" required="1"/>
                            <field name="purpose" required="1"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="total_visits" readonly="1"/>
                            <field name="zc_approver_id" readonly="1"/>
                            <field name="zc_approval_mode" readonly="1"/>
                        </group>
                    </group>

                    <group string="Expenses Claim" col="4">
                        <field name="transport_cost" string="Transport"/>
                        <field name="food_cost" string="Food"/>
                        <field name="other_cost" string="Other"/>
                        <field name="total_cost" string="Total" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Target Lines">
                            <field name="target_line_ids" nolabel="1">
                                <list editable="bottom" string="Target Lines">
                                    <field name="employee_ids" widget="many2many_tags" domain="[('active', '=', True)]"/>
                                    <field name="from_location" placeholder="From"/>
                                    <field name="expected_km" string="KM"/>
                                    <field name="customer_ids" widget="many2many_tags" placeholder="Customers" domain="[('active', '=', True), ('customer_rank', '&gt;', 0), ('user_ids', '=', False)]"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <group>
                                <field name="manager_notes" placeholder="Manager notes..."/>
                                <field name="internal_notes" widget="html" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_salesperson_visit_plan_list" model="ir.ui.view">
        <field name="name">salesperson.visit.plan.list</field>
        <field name="model">salesperson.visit.plan</field>
        <field name="arch" type="xml">
            <list string="Visit Plans" multi_edit="1">
                <field name="name"/>
                <field name="user_id"/>
                <field name="zc_approver_id"/>
                <field name="zc_approval_mode"/>
                <field name="zc_requester_role"/>
                <field name="visit_date"/>
                <field name="purpose"/>
                <field name="total_visits"/>
                <field name="customer_names" string="Customers" readonly="1"/>
                <field name="total_cost"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>


    <record id="view_zc_visit_plan_search" model="ir.ui.view">
      <field name="name">salesperson.visit.plan.search.hierarchy</field>
      <field name="model">salesperson.visit.plan</field>
      <field name="arch" type="xml">
        <search>
          <field name="name"/><field name="user_id"/><field name="zc_approver_id"/>
          <field name="visit_date"/><field name="state"/><field name="purpose"/>
          <field name="zc_customer_search" string="Customer"/>
          <filter name="my_plans" string="My Plans" domain="[('user_id','=',uid)]"/>
          <filter name="my_approvals" string="My Approvals" domain="[('zc_approver_id','=',uid),('state','=','submitted')]"/>
          <filter name="my_team" string="My Team" domain="[('zc_in_my_team','=',True)]"/>
          <separator/>
          <filter name="pending" string="Pending Approval" domain="[('state','=','submitted')]"/>
          <filter name="auto_approval" string="Auto Approved" domain="[('zc_approval_mode','=','auto'),('state','=','approved')]"/>
          <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
          <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
          <filter name="running" string="In Progress" domain="[('state','=','in_progress')]"/>
          <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
          <filter name="today" string="Today" domain="[('visit_date','=',context_today().strftime('%Y-%m-%d'))]"/>
          <filter name="visit_date_period" string="Visit Date" date="visit_date" default_period="month"/>
          <group>
            <filter name="by_role" string="Requester Role" context="{'group_by':'zc_requester_role'}"/>
            <filter name="by_user" string="Salesperson" context="{'group_by':'user_id'}"/>
            <filter name="by_approver" string="Approver" context="{'group_by':'zc_approver_id'}"/>
            <filter name="by_state" string="Status" context="{'group_by':'state'}"/>
            <filter name="by_date" string="Visit Date" context="{'group_by':'visit_date:day'}"/>
            <filter name="by_purpose" string="Purpose" context="{'group_by':'purpose'}"/>
          </group>
        </search>
      </field>
    </record>
    <record id="view_zc_visit_plan_kanban" model="ir.ui.view">
      <field name="name">salesperson.visit.plan.kanban.hierarchy</field>
      <field name="model">salesperson.visit.plan</field>
      <field name="arch" type="xml">
        <kanban class="o_zc_visit_plan_kanban">
          <field name="name"/><field name="user_id"/><field name="state"/>
          <field name="visit_date"/><field name="zc_approver_id"/>
          <field name="total_visits"/><field name="purpose"/>
          <field name="kanban_salesperson_initials"/><field name="kanban_route_data"/>
          <field name="kanban_route_extra_count"/>
          <templates><t t-name="card">
            <article t-attf-class="oe_kanban_global_click o_zc_visit_card zc-plan-state-#{record.state.raw_value or 'draft'}">
              <div class="zc-plan-status-bar"/>
              <div class="zc-plan-card-body">
                <div class="zc-plan-card-head">
                  <strong class="zc-plan-reference"><field name="name"/></strong>
                  <span class="zc-plan-state"><field name="state"/></span>
                </div>
                <div class="zc-plan-salesperson">
                  <span class="zc-plan-avatar"><field name="kanban_salesperson_initials"/></span>
                  <span><field name="user_id"/></span>
                </div>
                <div class="zc-plan-meta">
                  <span>▣ <field name="visit_date"/></span>
                  <span>⌾ <field name="purpose"/></span>
                </div>

                <section class="zc-plan-route">
                  <div class="zc-plan-route-head">
                    <span>Customer Route</span>
                    <span><field name="total_visits"/> stop<t t-if="record.total_visits.raw_value != 1">s</t></span>
                  </div>
                  <t t-if="record.kanban_route_data.raw_value">
                    <t t-foreach="record.kanban_route_data.raw_value" t-as="stop">
                      <div class="zc-plan-stop">
                        <span class="zc-plan-stop-icon">⌖</span>
                        <div class="zc-plan-stop-copy">
                          <strong t-esc="stop.name"/>
                          <span class="zc-plan-stop-address" t-esc="stop.address"/>
                          <span class="zc-plan-stop-time">◷ <t t-esc="stop.visit_time"/> · <b t-attf-class="zc-stop-status zc-stop-#{stop.status_class || 'pending'}" t-esc="stop.status_label"/></span>
                        </div>
                        <span class="zc-plan-distance" t-esc="stop.distance"/>
                      </div>
                    </t>
                    <div t-if="record.kanban_route_extra_count.raw_value" class="zc-plan-more-stops">+<field name="kanban_route_extra_count"/> more customer<t t-if="record.kanban_route_extra_count.raw_value != 1">s</t></div>
                  </t>
                  <div t-else="" class="zc-plan-route-empty">No customer locations added yet.</div>
                </section>
              </div>
            </article>
          </t></templates>
        </kanban>
      </field>
    </record>
    <!-- Actions -->
    <record id="action_salesperson_visit_plan" model="ir.actions.act_window">
        <field name="name">Visit Plans</field>
        <field name="res_model">salesperson.visit.plan</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_zc_visit_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_sm">Click to create a new visit plan</p>
        </field>
    </record>

    <record id="action_salesperson_visit_plan_my" model="ir.actions.act_window">
        <field name="name">My Visit Plans</field>
        <field name="res_model">salesperson.visit.plan</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_zc_visit_plan_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
    </record>

</odoo>
