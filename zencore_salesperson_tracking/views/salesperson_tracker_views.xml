<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="view_salesperson_tracker_form" model="ir.ui.view">
        <field name="name">salesperson.tracker.form</field>
        <field name="model">salesperson.tracker</field>
        <field name="arch" type="xml">
            <form string="Tracking Report">
                <header>
                    <button name="action_print_tracking_report" string="Print Report" type="object" class="btn-secondary" groups="zencore_salesperson_tracking.group_salesperson_ceo,zencore_salesperson_tracking.group_salesperson_manager,zencore_salesperson_tracking.group_salesperson_supervisor"/>
                    <button name="action_view_moving_map" string="Map" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,offline,live,completed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group string="Basic Information">
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="visit_date" readonly="1"/>
                            <field name="purpose" readonly="1"/>
                            <field name="priority" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_visits" readonly="1"/>
                            <field name="total_visited" readonly="1"/>
                            <field name="skipped_visits" readonly="1" decoration-danger="skipped_visits > 0"/>
                        </group>
                    </group>
                    <group string="Expenses">
                        <group string="Claimed">
                            <field name="transport_cost"/>
                            <field name="food_cost"/>
                            <field name="other_cost"/>
                            <field name="total_cost" readonly="1"/>
                        </group>
                        <group string="Actual">
                            <field name="actual_transport_cost"/>
                            <field name="actual_food_cost"/>
                            <field name="actual_other_cost"/>
                            <field name="actual_total_cost" readonly="1"/>
                        </group>
                    </group>
                    <group string="Timing">
                        <group>
                            <field name="checkin_time" readonly="1"/>
                            <field name="checkout_time" readonly="1"/>
                            <field name="duration_minutes" string="Duration (Min)" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_distance_km" string="Total Distance (KM)" readonly="1"/>
                            <field name="total_tracking_time_minutes" string="Total Tracking Time (min)" readonly="1"/>
                            <field name="traveling_time_minutes" string="Traveling Time (min)" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Target Lines" name="target_lines">
                            <field name="target_line_ids">
                                <list>
                                    <field name="employee_ids" widget="many2many_tags"/>
                                    <field name="from_location"/>
                                    <field name="expected_km"/>
                                    <!-- customer_ids kept editable for Add-a-line/reassignment,
                                         but hidden from view — customers_visited_html shows the
                                         same set as colored chips (dark green once actually
                                         visited, grey while pending) instead of the plain,
                                         visit-status-blind many2many_tags widget. -->
                                    <field name="customer_ids" widget="many2many_tags" column_invisible="1"/>
                                    <field name="customers_visited_html" widget="html" string="Customers"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visited Lines" name="visited_lines">
                            <field name="visited_line_ids">
                                <list string="Visited Customers" decoration-success="time_spent_minutes > 0">
                                    <field name="partner_id"/>
                                    <field name="checkin_time" string="In"/>
                                    <field name="checkout_time" string="Exit"/>
                                    <field name="time_spent_minutes" string="Time Spent (min)"/>
                                    <field name="rating"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tracking Sessions" name="sessions">
                            <field name="session_ids">
                                <list>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="duration_display"/>
                                </list>
                            </field>
                        </page>
                        <page string="Idle Time" name="idle_time">
                            <div class="oe_button_box" style="margin-bottom: 8px;">
                                <button name="action_recompute_idle_time" string="Recompute Idle Time" type="object" class="btn-secondary"/>
                            </div>
                            <field name="idle_line_ids">
                                <list editable="bottom" decoration-warning="duration_minutes > 30">
                                    <field name="location_name" string="Location Name" readonly="1"/>
                                    <field name="duration_minutes" string="Total Time Spent (min)" readonly="1"/>
                                    <field name="start_time" string="Idle Since" readonly="1" optional="hide"/>
                                    <field name="end_time" string="Idle Until" readonly="1" optional="hide"/>
                                    <field name="remarks" string="Remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Related Notes" name="notes">
                            <field name="related_notes" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Kanban View ───────────────────────────────────────────────────── -->
    <!--
        Rules:
        - Top-right corner: status badge (Live green pulse / Idle amber / Offline grey)
        - Map button: always /moving_map/<id> for the clicked record, for everyone.
          Tracking controls are intentionally kept in the mobile app.
        - Completed is shown only after every planned customer has been checked out.
        - A past-day tracker with any unfinished visit is marked Failed.
    -->
    <record id="view_salesperson_tracker_kanban" model="ir.ui.view">
        <field name="name">salesperson.tracker.kanban</field>
        <field name="model">salesperson.tracker</field>
        <field name="arch" type="xml">
            <kanban create="true" class="o_zc_tracking_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="visit_date"/>
                <field name="duration_hours"/>
                <field name="total_distance_km"/>
                <field name="total_visits"/>
                <field name="total_visited"/>
                <field name="state"/>
                <field name="is_tracking"/>
                <field name="kanban_salesperson_initials"/>
                <field name="kanban_route_data"/>
                <field name="kanban_route_extra_count"/>
                <templates>
                    <t t-name="card">
                        <article t-attf-class="oe_kanban_global_click o_zc_tracking_card zc-tracker-state-#{record.state.raw_value or 'planned'}">
                            <div class="zc-tracker-status-bar"/>
                            <div class="zc-tracker-card-body">
                                <div class="zc-tracker-card-head">
                                    <strong class="zc-tracker-reference"><field name="name"/></strong>
                                    <span class="zc-tracker-state">
                                        <span t-if="record.is_tracking.raw_value" class="zc-tracker-live-dot"/> <t t-if="record.is_tracking.raw_value">Live</t><t t-else=""><field name="state"/></t>
                                    </span>
                                </div>
                                <div class="zc-tracker-salesperson">
                                    <span class="zc-tracker-avatar"><field name="kanban_salesperson_initials"/></span>
                                    <span><field name="user_id"/></span>
                                </div>
                                <div class="zc-tracker-meta">
                                    <span>▣ <field name="visit_date"/></span>
                                    <span t-if="record.state.raw_value == 'completed'" class="zc-tracker-outcome completed">✓ Route completed</span>
                                    <span t-elif="record.state.raw_value == 'failed'" class="zc-tracker-outcome failed">⚠ <t t-esc="record.total_visits.raw_value - record.total_visited.raw_value"/> missed</span>
                                    <span t-elif="record.state.raw_value == 'live'" class="zc-tracker-outcome live">● GPS recording</span>
                                    <span t-else="" class="zc-tracker-outcome pending"><t t-esc="record.total_visits.raw_value - record.total_visited.raw_value"/> pending</span>
                                </div>

                                <section class="zc-tracker-route">
                                    <div class="zc-tracker-route-head">
                                        <span>Customer Route</span>
                                        <span><field name="total_visited"/> / <field name="total_visits"/> completed</span>
                                    </div>
                                    <t t-if="record.kanban_route_data.raw_value">
                                        <t t-foreach="record.kanban_route_data.raw_value" t-as="stop">
                                            <div class="zc-tracker-stop">
                                                <span class="zc-tracker-stop-icon">⌖</span>
                                                <div class="zc-tracker-stop-copy">
                                                    <strong t-esc="stop.name"/>
                                                    <span class="zc-tracker-stop-address" t-esc="stop.address"/>
                                                    <span class="zc-tracker-stop-time">◷ <t t-esc="stop.visit_time"/> · <b t-attf-class="zc-tracker-stop-status zc-tracker-stop-#{stop.status_class || 'pending'}" t-esc="stop.status_label"/></span>
                                                </div>
                                                <span class="zc-tracker-distance" t-esc="stop.distance"/>
                                            </div>
                                        </t>
                                        <div t-if="record.kanban_route_extra_count.raw_value" class="zc-tracker-more-stops">+<field name="kanban_route_extra_count"/> more customer<t t-if="record.kanban_route_extra_count.raw_value != 1">s</t></div>
                                    </t>
                                    <div t-else="" class="zc-tracker-route-empty">No customer route available.</div>
                                </section>

                                <div class="zc-tracker-stats">
                                    <span><b><field name="total_distance_km"/> km</b>Distance</span>
                                    <span><b><field name="duration_hours"/> h</b>Tracking time</span>
                                </div>
                            </div>
                            <div class="zc-tracker-actions" onclick="event.stopPropagation()">
                                <a t-attf-href="/salesperson_tracking/moving_map/#{record.id.raw_value}?source=live"
                                   class="zc-tracker-map-link" target="_blank">⌖ Open Movement Map</a>
                            </div>
                        </article>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="view_salesperson_tracker_list" model="ir.ui.view">
        <field name="name">salesperson.tracker.list</field>
        <field name="model">salesperson.tracker</field>
        <field name="arch" type="xml">
            <list string="Tracking Reports"
                  decoration-success="state=='completed'"
                  decoration-primary="state=='live'"
                  decoration-danger="state=='failed'"
                  decoration-warning="state=='offline'"
                  decoration-muted="state=='planned'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="visit_date"/>
                <field name="state" widget="badge"/>
                <field name="is_tracking" widget="boolean"/>
                <field name="total_visits"/>
                <field name="total_visited"/>
                <field name="total_distance_km"/>
                <field name="duration_hours"/>
                <button type="object" name="action_view_moving_map" string="Map" icon="fa-map-marker"/>
            </list>
        </field>
    </record>

    <record id="view_zc_tracker_search" model="ir.ui.view">
      <field name="name">salesperson.tracker.search.hierarchy</field>
      <field name="model">salesperson.tracker</field>
      <field name="arch" type="xml">
        <search>
          <field name="name"/><field name="user_id"/><field name="plan_id"/>
          <field name="visit_date"/><field name="state"/>
          <filter name="my_tracking" string="My Tracking" domain="[('user_id','=',uid)]"/>
          <filter name="my_team_tracking" string="My Team" domain="[('zc_in_my_team','=',True)]"/>
          <separator/>
          <filter name="live" string="Live Now" domain="[('is_tracking','=',True)]"/>
          <filter name="offline" string="Stopped" domain="[('is_tracking','=',False)]"/>
          <filter name="today" string="Today" domain="[('visit_date','=',context_today().strftime('%Y-%m-%d'))]"/>
          <filter name="visit_date_period" string="Visit Date" date="visit_date" default_period="month"/>
          <group>
            <filter name="by_user" string="User" context="{'group_by':'user_id'}"/>
            <filter name="by_plan" string="Plan" context="{'group_by':'plan_id'}"/>
            <filter name="by_state" string="Status" context="{'group_by':'state'}"/>
            <filter name="by_date" string="Date" context="{'group_by':'visit_date:day'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ── Actions ───────────────────────────────────────────────────────── -->
    <record id="action_salesperson_tracker_kanban" model="ir.actions.act_window">
        <field name="name">Live Tracking</field>
        <field name="res_model">salesperson.tracker</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_zc_tracker_search"/>
        <!-- No date domain: all records (past/today/future) are visible here now.
             "Traceability" (Start/Stop, /live page access) is still restricted to
             today's own record at the action_open_live_tracking_page level — a
             past or future record just opens the read-only Map instead. -->
    </record>

    <record id="action_salesperson_tracker_my_kanban" model="ir.actions.act_window">
        <field name="name">My Tracking</field>
        <field name="res_model">salesperson.tracker</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_zc_tracker_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
    </record>

    <record id="action_salesperson_tracker" model="ir.actions.act_window">
        <field name="name">Tracking Reports</field>
        <field name="res_model">salesperson.tracker</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_salesperson_tracker_my" model="ir.actions.act_window">
        <field name="name">My Tracking</field>
        <field name="res_model">salesperson.tracker</field>
        <field name="view_mode">form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
    </record>

</odoo>
