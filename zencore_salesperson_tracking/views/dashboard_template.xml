<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="salesperson_dashboard" name="Salesperson Live Tracking Dashboard">
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <title>Dashboard — Salesperson Tracking</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&amp;family=DM+Mono:wght@400;500&amp;display=swap" rel="stylesheet"/>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
        <link rel="stylesheet" type="text/css" href="/zencore_salesperson_tracking/static/src/css/dashboard_view.css?v=32.0.0"/>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    </head>
    <body>

    <div id="dash-config"
         style="display:none"
         t-att-data-period="period"
         t-att-data-is-live="'1' if is_live else '0'"
         t-att-data-salesman-id="selected_salesman_id or ''"
         t-att-data-date-from="date_from_str"
         t-att-data-date-to="date_to_str"></div>

    <div class="dash-nav">
        <div class="nav-brand">
            <div class="nav-brand-icon">ZF</div>
            <div>
                <div class="nav-brand-text"><span class="brand-blue">zen</span><span class="brand-green">core</span> FIELD</div>
                <div class="nav-brand-sub">Salesperson Tracking · Live Monitoring</div>
            </div>
        </div>
        <div class="nav-right">
            <div class="refresh-meta" t-if="is_live">
                <span class="refresh-dot"></span>
                <div>
                    <div id="last-refresh-text" class="refresh-title">Live data</div>
                    <div class="refresh-sub">Auto refresh: 10 seconds</div>
                </div>
            </div>
            <t t-if="is_live">
                <span class="nav-live-badge"><span class="nav-live-dot"></span> Live</span>
            </t>
            <span class="nav-role-badge" t-esc="dashboard_role"/>
            <t t-if="period == 'custom'">
                <a class="nav-refresh-btn" title="Refresh"
                   t-attf-href="/salesperson/dashboard?date_from=#{date_from_str}&amp;date_to=#{date_to_str}#{'&amp;salesman_id=%s' % selected_salesman_id if selected_salesman_id else ''}">&#8635;</a>
            </t>
            <t t-else="">
                <a class="nav-refresh-btn" title="Refresh"
                   t-attf-href="/salesperson/dashboard?period=#{period}#{'&amp;salesman_id=%s' % selected_salesman_id if selected_salesman_id else ''}">&#8635;</a>
            </t>
        </div>
    </div>

    <div class="dash-shell">
        <div class="dash-heading-row">
            <div>
                <div class="dash-title">Salesperson Tracking</div>
                <div class="dash-date" t-esc="period_label"/>
            </div>

            <div class="dash-controls">
                <div class="period-tabs">
                    <a t-attf-href="/salesperson/dashboard?period=today#{'&amp;salesman_id=%s' % selected_salesman_id if selected_salesman_id else ''}"
                       t-attf-class="period-tab #{'active' if period == 'today' else ''}">Today</a>
                    <a t-attf-href="/salesperson/dashboard?period=yesterday#{'&amp;salesman_id=%s' % selected_salesman_id if selected_salesman_id else ''}"
                       t-attf-class="period-tab #{'active' if period == 'yesterday' else ''}">Yesterday</a>
                    <a t-attf-href="/salesperson/dashboard?period=weekly#{'&amp;salesman_id=%s' % selected_salesman_id if selected_salesman_id else ''}"
                       t-attf-class="period-tab #{'active' if period == 'weekly' else ''}">This Week</a>
                    <a t-attf-href="/salesperson/dashboard?period=monthly#{'&amp;salesman_id=%s' % selected_salesman_id if selected_salesman_id else ''}"
                       t-attf-class="period-tab #{'active' if period == 'monthly' else ''}">This Month</a>
                </div>

                <form class="date-range-form" id="zc-date-form" method="get" action="/salesperson/dashboard">
                    <input id="zc-date-mode" type="hidden" t-att-value="'single' if date_from_str == date_to_str else 'range'"/>
                    <div class="zc-date-mode-switch" role="group" aria-label="Date filter mode">
                        <button type="button" data-date-mode="single"
                                t-att-class="'selected' if date_from_str == date_to_str else ''"
                                t-att-aria-pressed="'true' if date_from_str == date_to_str else 'false'">Single date</button>
                        <button type="button" data-date-mode="range"
                                t-att-class="'selected' if date_from_str != date_to_str else ''"
                                t-att-aria-pressed="'true' if date_from_str != date_to_str else 'false'">Date range</button>
                    </div>
                    <div class="zc-date-fields">
                        <label class="zc-date-field" for="zc-date-from">
                            <span id="zc-date-from-label">Date</span>
                            <input id="zc-date-from" type="date" class="date-range-input" name="date_from" aria-label="Date from" t-att-value="date_from_str" required="required"/>
                        </label>
                        <span class="date-range-sep" id="zc-date-separator" aria-hidden="true">→</span>
                        <label class="zc-date-field" id="zc-date-to-wrap" for="zc-date-to">
                            <span>To</span>
                            <input id="zc-date-to" type="date" class="date-range-input" name="date_to" aria-label="Date to" t-att-value="date_to_str" required="required"/>
                        </label>
                    </div>
                    <button type="submit" class="date-range-apply"><span>Apply</span><span aria-hidden="true">→</span></button>
                </form>

            </div>
        </div>

        <t t-if="is_live">
            <div class="kpi-grid kpi-priority-grid" aria-label="Priority tracking KPIs">
                <div class="kpi-card kpi-green">
                    <div class="kpi-icon">●</div>
                    <div class="kpi-body">
                        <div class="kpi-label">Currently Active</div>
                        <div class="kpi-value" id="kpi-active" t-esc="summary['active_count']"/>
                        <div class="kpi-sub">Tracking now</div>
                    </div>
                </div>
                <div class="kpi-card kpi-violet">
                    <div class="kpi-icon">⌖</div>
                    <div class="kpi-body">
                        <div class="kpi-label">At Customer</div>
                        <div class="kpi-value" id="kpi-at-customer" t-esc="summary['at_customer_count']"/>
                        <div class="kpi-sub">On customer location</div>
                    </div>
                </div>
                <div class="kpi-card kpi-red">
                    <div class="kpi-icon">●</div>
                    <div class="kpi-body">
                        <div class="kpi-label">Inactive</div>
                        <div class="kpi-value" id="kpi-offline" t-esc="summary['offline_count']"/>
                        <div class="kpi-sub">Stopped or stale GPS</div>
                    </div>
                </div>
                        <div class="kpi-card kpi-green">
                            <div class="kpi-icon">✓</div>
                            <div class="kpi-body">
                                <div class="kpi-label">Completed Visits</div>
                                <div class="kpi-value" id="kpi-completed" t-esc="summary['total_covered']"/>
                                <div class="kpi-sub"><span id="kpi-visit-rate" t-esc="summary['visit_rate']"/>% visit rate</div>
                            </div>
                        </div>
                        <div class="kpi-card kpi-red">
                            <div class="kpi-icon">×</div>
                            <div class="kpi-body">
                                <div class="kpi-label">Remaining Visits</div>
                                <div class="kpi-value" id="kpi-missed" t-esc="summary['missed_count']"/>
                                <div class="kpi-sub">Planned but not completed</div>
                            </div>
                        </div>
            </div>
        </t>

        <t t-else="">
            <div class="kpi-grid is-report">
                <div class="kpi-card kpi-report-card kpi-green">
                    <div class="kpi-icon">✓</div>
                    <div class="kpi-body">
                        <div class="kpi-label">Completed Visits</div>
                        <div class="kpi-value" id="kpi-completed" t-esc="summary['total_covered']"/>
                        <div class="kpi-sub"><span id="kpi-visit-rate" t-esc="summary['visit_rate']"/>% visit rate</div>
                    </div>
                </div>
                <div class="kpi-card kpi-report-card kpi-red">
                    <div class="kpi-icon">×</div>
                    <div class="kpi-body">
                        <div class="kpi-label">Missed Visits</div>
                        <div class="kpi-value" id="kpi-missed" t-esc="summary['missed_count']"/>
                        <div class="kpi-sub">Across selected period</div>
                    </div>
                </div>
            </div>
        </t>

        <t t-if="is_live">
            <div class="dashboard-live-grid">
                <div class="map-card">
                    <div class="panel-head">
                        <div class="panel-title-wrap">
                            <div class="panel-title">Live Map</div>
                            <span class="panel-badge">Real-time</span>
                        </div>
                        <div class="map-location-label" id="map-scope-count"><span id="map-active-count" t-esc="summary['active_count']"/> Active · <span id="map-inactive-count" t-esc="summary['inactive_count']"/> Inactive</div>
                    </div>
                    <div class="map-toolbar">
                      <div class="map-search-wrap">
                        <input id="map-salesperson-search" type="search" placeholder="Find salesperson on map…" autocomplete="off" aria-label="Search salesperson location"/>
                        <div id="map-salesperson-suggestions" class="map-suggestions" role="listbox"></div>
                      </div>
                      <div class="map-status-tabs" aria-label="Map status filter">
                        <button type="button" data-map-filter="all" class="selected">All</button>
                        <button type="button" data-map-filter="active">Active</button>
                        <button type="button" data-map-filter="inactive">Inactive</button>
                      </div>
                      <span id="map-search-feedback" aria-live="polite"></span>
                    </div>
                    <div class="live-map-shell">
                        <div id="live-map"></div>
                        <div class="map-target-legend" aria-label="Customer target map legend">
                            <span class="map-target-legend-pin" aria-hidden="true"></span>
                            <span><strong>Customer targets</strong><small>Target: salesperson</small></span>
                        </div>
                    </div>
                </div>

                <div class="side-stack">
                    <div class="side-card activity-card">
                        <div class="panel-head compact">
                            <div class="panel-title">Recent Activities</div>
                            <span class="panel-muted">Today</span>
                        </div>
                        <div class="activity-list" id="activity-list">
                            <t t-if="not activity_feed">
                                <div class="side-empty">No recent activities yet.</div>
                            </t>
                            <t t-foreach="activity_feed" t-as="a">
                                <div class="activity-item">
                                    <div class="activity-icon" t-attf-style="background:#{a['color']}" t-esc="a['icon']"/>
                                    <div class="activity-time" t-esc="a['time']"/>
                                    <div class="activity-text" t-esc="a['text']"/>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="side-card alert-card">
                        <div class="panel-head compact">
                            <div class="panel-title">Alerts &amp; Notifications</div>
                            <span class="panel-muted">Today</span>
                        </div>
                        <div class="alert-list" id="alert-list">
                            <t t-if="not dashboard_alerts">
                                <div class="alert-item success">
                                    <span class="alert-icon">✓</span>
                                    <div><strong>No tracking alerts</strong><small>Everything looks normal right now.</small></div>
                                </div>
                            </t>
                            <t t-foreach="dashboard_alerts" t-as="a">
                                <div t-attf-class="alert-item #{a['level']}">
                                    <span class="alert-icon" t-esc="a['icon']"/>
                                    <div>
                                        <strong t-esc="a['text']"/>
                                        <small t-esc="a['detail']"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>

        <div class="table-card">
            <div class="panel-head table-panel-head">
                <div>
                    <div class="panel-title">Salesman Performance</div>
                    <div class="panel-sub">Visits, distance, tracking time and GPS health</div>
                </div>
                <div class="table-head-actions">
                    <span class="table-count"><span id="table-row-count" t-esc="len(rows)"/> salesmen</span>
                </div>
            </div>

            <t t-if="not rows">
                <div class="empty-state">No tracking records for this period.</div>
            </t>
            <t t-else="">
                <div class="table-scroll">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Salesman</th>
                                <th>Planned</th>
                                <th>Visited</th>
                                <th t-esc="'Remaining' if is_live else 'Missed'"/>
                                <th>Visit Rate</th>
                                <th>Distance</th>
                                <th>Tracking Time</th>
                                <th>First Start</th>
                                <th>Last Update</th>
                                <t t-if="is_live"><th>GPS Health</th></t>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="rep-table-body">
                            <t t-foreach="rows" t-as="r">
                                <tr t-att-data-tracker-id="r['id']" t-att-data-user-id="r['user_id']">
                                    <td class="row-number" t-esc="r_index + 1"/>
                                    <td>
                                        <div class="rep-cell">
                                            <div class="rep-avatar" t-attf-style="background:#{r['gradient']}" t-esc="r['initials']"/>
                                            <div>
                                                <div class="rep-name" t-esc="r['name']"/>
                                                <t t-if="is_live"><div class="rep-location" t-esc="r['location']"/></t>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="cell-planned" t-esc="r['total']"/>
                                    <td class="cell-visited positive" t-esc="r['covered']"/>
                                    <td class="cell-missed negative" t-esc="r['missed']"/>
                                    <td>
                                        <div class="visit-rate-bar">
                                            <span class="cell-pct" t-esc="str(r['pct']) + '%'"/>
                                            <div class="vr-track"><div class="vr-fill" t-attf-style="width:#{r['pct']}%"></div></div>
                                        </div>
                                    </td>
                                    <td class="cell-distance" t-esc="r['distance']"/>
                                    <td class="cell-tracking-time" t-esc="r['tracking_time']"/>
                                    <td class="cell-first-start" t-esc="r['first_start']"/>
                                    <td>
                                        <span class="cell-last-update" t-att-data-epoch="r['last_seen_epoch']" t-esc="r['last_update']"/>
                                    </td>
                                    <t t-if="is_live">
                                        <td>
                                            <span class="gps-health-pill" t-attf-style="--gps-color:#{r['gps_health_color']}">
                                                <i></i><span class="gps-health-text" t-esc="r['gps_health']"/>
                                            </span>
                                        </td>
                                    </t>
                                    <td>
                                        <div class="row-actions">
                                            <t t-if="is_live">
                                                <button type="button" class="action-btn primary"
                                                        t-att-disabled="'disabled' if r['status'] == 'offline' or not r['id'] else None"
                                                        t-att-onclick="'focusSalesman(%s); return false;' % r['id']">Live</button>
                                            </t>
                                            <button t-if="r['id']" type="button" class="action-btn" t-att-onclick="'openMovementMap(%s); return false;' % r['id']">Route</button>
                                            <a class="action-btn visit-action"
                                               t-attf-href="/salesperson/dashboard/visits?user_id=#{r['user_id']}&amp;date_from=#{date_from_str}&amp;date_to=#{date_to_str}">Visits</a>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </div>

    <div id="visit-details-overlay" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.48);z-index:9999;overflow:auto;padding:5vh 3vw;" onclick="if(event.target===this)closeVisitDetails()">
      <div style="background:white;border-radius:14px;max-width:1200px;margin:auto;padding:24px;box-shadow:0 15px 50px #0003;">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
          <h2 id="visit-details-heading" style="margin:0">Visit Details</h2>
          <button type="button" onclick="closeVisitDetails()" aria-label="Close visit details" style="border:0;background:#f1f5f9;border-radius:8px;padding:8px 14px;cursor:pointer">✕</button>
        </div>
        <p id="visit-details-summary" style="color:#64748b;margin:10px 0 20px"></p>
        <div id="visit-details-content" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:18px"></div>
      </div>
    </div>
    <script src="/zencore_salesperson_tracking/static/src/js/dashboard_live_map.js?v=33.0.0"></script>
    </body>
</html>
</template>

<template id="dashboard_salesperson_visit_details" name="Dashboard Salesperson Visit Details">
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <title><t t-esc="salesperson.name"/> — Visit Details</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
        <link rel="stylesheet" type="text/css" href="/zencore_salesperson_tracking/static/src/css/dashboard_view.css?v=35.0.0"/>
        <style>
            .visit-detail-page { max-width:1280px; margin:0 auto; padding:24px 18px 42px; }
            .visit-detail-top { display:flex; gap:16px; align-items:flex-start; justify-content:space-between; margin-bottom:18px; }
            .visit-detail-back { display:inline-flex; align-items:center; gap:7px; min-height:34px; padding:7px 11px; border:1px solid #cfe0e7; border-radius:9px; color:#075b94; background:#fff; text-decoration:none; font-size:12px; font-weight:700; }
            .visit-detail-title { margin:8px 0 3px; color:#102d47; font-size:25px; line-height:1.2; letter-spacing:-.025em; }
            .visit-detail-subtitle { color:#6f8597; font-size:12px; }
            .visit-detail-filter { display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding:11px; background:#fff; border:1px solid #d9e7eb; border-radius:13px; box-shadow:0 4px 15px rgba(10,69,95,.06); }
            .visit-detail-filter input { height:36px; min-width:190px; border:1px solid #cce0e6; border-radius:8px; padding:0 10px; color:#173a53; font:600 12px "DM Sans",sans-serif; }
            .visit-detail-filter input[type="search"] { min-width:265px; }
            .visit-detail-filter button { height:36px; border:0; border-radius:8px; padding:0 14px; cursor:pointer; color:#fff; background:#08639c; font:700 12px "DM Sans",sans-serif; }
            .visit-detail-summary { display:grid; grid-template-columns:repeat(5,minmax(120px,1fr)); gap:10px; margin-bottom:17px; }
            .visit-summary-card { padding:14px; border:1px solid #d9e7eb; border-radius:13px; background:#fff; box-shadow:0 3px 12px rgba(10,69,95,.05); }
            .visit-summary-card span { display:block; color:#758b9b; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
            .visit-summary-card strong { display:block; margin-top:6px; color:#13334c; font-size:23px; line-height:1; }
            .visit-summary-card.completed strong { color:#098454; }.visit-summary-card.remaining strong { color:#b45309; }
            .visit-detail-list { display:grid; gap:13px; }
            .visit-plan-card { overflow:hidden; border:1px solid #d8e5ea; border-radius:14px; background:#fff; box-shadow:0 3px 13px rgba(10,69,95,.055); }
            .visit-plan-head { display:flex; align-items:flex-start; gap:12px; padding:14px 16px; border-bottom:1px solid #e4eef1; }
            .visit-plan-main { min-width:0; flex:1; }.visit-plan-name { color:#102d47; font-size:15px; font-weight:800; }.visit-plan-meta { margin-top:4px; color:#678095; font-size:11px; }
            .visit-status { display:inline-flex; align-items:center; justify-content:center; border-radius:999px; padding:5px 9px; white-space:nowrap; font-size:10px; font-weight:800; }
            .visit-status.completed { background:#e8f8ec; color:#087c3c; }.visit-status.tracking,.visit-status.in_progress { background:#e6f4f7; color:#087080; }.visit-status.approved { background:#ebf2ff; color:#215fbe; }.visit-status.submitted { background:#fff6df; color:#a76300; }.visit-status.missed { background:#fff0f1; color:#c33448; }.visit-status.draft,.visit-status.rejected { background:#eef2f5; color:#607080; }
            .visit-plan-metrics { display:flex; align-items:center; gap:14px; padding:10px 16px; background:#f8fbfc; color:#627c8f; font-size:11px; }.visit-plan-metrics b { color:#183c55; }
            .visit-target-list { display:grid; gap:0; }.visit-target { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:center; padding:12px 16px; border-top:1px solid #edf3f5; }
            .visit-target:first-child { border-top:0; }.visit-target-name { color:#17344d; font-size:12px; font-weight:800; }.visit-target-address { max-width:780px; margin-top:3px; overflow:hidden; color:#7890a1; font-size:10px; text-overflow:ellipsis; white-space:nowrap; }.visit-target-time { margin-top:5px; color:#557185; font-size:10px; }
            .visit-target-right { min-width:132px; text-align:right; }.visit-target-distance { display:block; margin-bottom:5px; color:#527083; font-size:10px; font-weight:700; }.visit-target-status { display:inline-block; border-radius:999px; padding:4px 8px; font-size:9px; font-weight:800; }.visit-target-status.completed { color:#087c3c; background:#e8f8ec; }.visit-target-status.active { color:#087080; background:#e6f4f7; }.visit-target-status.remaining { color:#9a6505; background:#fff7e7; }.visit-target-status.missed { color:#bf3145; background:#fff0f1; }
            .visit-detail-empty { padding:50px 20px; text-align:center; color:#71889a; background:#fff; border:1px dashed #c8dbe1; border-radius:14px; }
            @media (max-width:820px) { .visit-detail-top { flex-direction:column; }.visit-detail-summary { grid-template-columns:repeat(2,minmax(0,1fr)); }.visit-detail-filter { width:100%; }.visit-detail-filter input,.visit-detail-filter input[type="search"] { min-width:0; width:100%; }.visit-detail-filter button { width:100%; }.visit-target { grid-template-columns:1fr; }.visit-target-right { text-align:left; }.visit-target-address { white-space:normal; } }
        </style>
    </head>
    <body>
        <div class="dash-nav">
            <div class="nav-brand">
                <div class="nav-brand-icon">ZF</div>
                <div><div class="nav-brand-text"><span class="brand-blue">zen</span><span class="brand-green">core</span> FIELD</div><div class="nav-brand-sub">Salesperson Tracking · Visit progress</div></div>
            </div>
        </div>
        <main class="visit-detail-page">
            <div class="visit-detail-top">
                <div>
                    <a class="visit-detail-back" t-attf-href="/salesperson/dashboard?date_from=#{date_from_str}&amp;date_to=#{date_to_str}">← Back to dashboard</a>
                    <h1 class="visit-detail-title"><t t-esc="salesperson.name"/> — Visit Details</h1>
                    <p class="visit-detail-subtitle"><t t-esc="period_label"/> · planned customer visits and live completion progress</p>
                </div>
                <form class="visit-detail-filter" method="get" action="/salesperson/dashboard/visits">
                    <input type="hidden" name="user_id" t-att-value="salesperson.id"/>
                    <input type="hidden" name="date_from" t-att-value="date_from_str"/>
                    <input type="hidden" name="date_to" t-att-value="date_to_str"/>
                    <input type="search" name="q" t-att-value="search_text" placeholder="Search plan ID, customer or address" aria-label="Search visit plans"/>
                    <button type="submit">Search</button>
                </form>
            </div>
            <section class="visit-detail-summary" aria-label="Visit summary">
                <div class="visit-summary-card"><span>Plans</span><strong t-esc="summary['plans']"/></div>
                <div class="visit-summary-card"><span>Planned visits</span><strong t-esc="summary['planned']"/></div>
                <div class="visit-summary-card completed"><span>Completed</span><strong t-esc="summary['completed']"/></div>
                <div class="visit-summary-card remaining"><span>Remaining</span><strong t-esc="summary['remaining']"/></div>
                <div class="visit-summary-card"><span>Visit rate</span><strong t-esc="str(summary['rate']) + '%'"/></div>
            </section>
            <section class="visit-detail-list">
                <t t-if="not plans"><div class="visit-detail-empty">No plans or customer visits match this search.</div></t>
                <t t-foreach="plans" t-as="plan">
                    <article class="visit-plan-card">
                        <header class="visit-plan-head">
                            <div class="visit-plan-main"><div class="visit-plan-name" t-esc="plan['name']"/><div class="visit-plan-meta"><span t-esc="plan['visit_date']"/> · <span t-esc="plan['purpose']"/></div></div>
                            <span t-attf-class="visit-status #{plan['status_class']}" t-esc="plan['status']"/>
                        </header>
                        <div class="visit-plan-metrics"><span><b t-esc="plan['target_count']"/> planned</span><span><b t-esc="plan['completed_count']"/> completed</span><span><b t-esc="plan['remaining_count']"/> remaining</span><span>Route: <b t-esc="plan['route_distance']"/></span></div>
                        <div class="visit-target-list">
                            <t t-foreach="plan['targets']" t-as="target">
                                <div class="visit-target">
                                    <div><div class="visit-target-name" t-esc="target['name']"/><div class="visit-target-address" t-esc="target['address']"/><div t-if="target['checkin']" class="visit-target-time">Check-in: <span t-esc="target['checkin']"/><t t-if="target['checkout']"> · Check-out: <span t-esc="target['checkout']"/></t><t t-if="target['duration']"> · <span t-esc="target['duration']"/></t></div></div>
                                    <div class="visit-target-right"><span class="visit-target-distance" t-esc="target['distance']"/><span t-attf-class="visit-target-status #{target['status_class']}" t-esc="target['status']"/></div>
                                </div>
                            </t>
                        </div>
                    </article>
                </t>
            </section>
        </main>
    </body>
</html>
</template>
</odoo>
