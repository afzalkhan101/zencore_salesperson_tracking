<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="paperformat_salesperson_performance" model="report.paperformat">
        <field name="name">Salesperson Performance Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="header_spacing">8</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_salesperson_performance" model="ir.actions.report">
        <field name="name">Salesperson Performance Report</field>
        <field name="model">salesperson.performance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zencore_salesperson_tracking.report_salesperson_performance_document</field>
        <field name="report_file">zencore_salesperson_tracking.report_salesperson_performance_document</field>
        <field name="paperformat_id" ref="paperformat_salesperson_performance"/>
        <field name="print_report_name">'Salesperson Performance - %s to %s' % (object.date_from, object.date_to)</field>
    </record>
    <template id="report_salesperson_performance_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="env.company"/>
                <t t-call="web.external_layout">
                    <div class="page" style="font-size:10px;color:#18243a;font-family:Arial,sans-serif;">
                        <style> .zc-table{width:100%;border-collapse:collapse;margin:8px 0 14px;} .zc-table th{background:#714b67;color:white;padding:5px;text-align:left;} .zc-table td{padding:5px;border:1px solid #d8dee6;vertical-align:top;word-wrap:break-word;} .zc-table thead{display:table-header-group;} .zc-table tr{page-break-inside:avoid;} .zc-heading{color:#714b67;font-size:16px;font-weight:bold;margin-top:12px;} </style>
                        <h2 style="color:#714b67;margin-bottom:3px;">Salesperson Performance &amp; Customer Visit Analysis</h2>
                        <div>
                            <strong t-esc="company.name"/> | Period: <span t-field="doc.date_from"/> – <span t-field="doc.date_to"/> | Details status: <span t-field="doc.visit_status"/>
                        </div>
                        <p>Planned completion excludes rejected and unapproved plans. Missed means the scheduled date has elapsed without a check-in. Unplanned check-ins are separate. Distance and expenses are tracking-session totals.</p>
                        <table class="zc-table">
                            <tr>
                                <th>Salespeople</th>
                                <th>Customers</th>
                                <th>Visited customers</th>
                                <th>Planned</th>
                                <th>Completed planned</th>
                                <th>Missed</th>
                            </tr>
                            <tr>
                                <td>
                                    <span t-field="doc.total_salespersons"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_customers"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_visited_customers"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_planned_visits"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_completed_visits"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_missed_visits"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Pending</th>
                                <th>In progress</th>
                                <th>Overdue</th>
                                <th>Awaiting approval</th>
                                <th>Rejected</th>
                                <th>Unplanned</th>
                            </tr>
                            <tr>
                                <td>
                                    <span t-field="doc.total_pending_visits"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_in_progress_visits"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_overdue_visits"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_awaiting_approval_visits"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_rejected_visits"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_unplanned_visits"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Distance km</th>
                                <th>Tracking min</th>
                                <th>Visit min</th>
                                <th>Idle min</th>
                                <th>Expense</th>
                                <th>Average rating</th>
                            </tr>
                            <tr>
                                <td>
                                    <span t-field="doc.total_distance_km"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_tracking_minutes"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_visit_minutes"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_idle_minutes"/>
                                </td>
                                <td>
                                    <span t-field="doc.total_expense"/>
                                </td>
                                <td>
                                    <span t-field="doc.average_rating"/>
                                </td>
                            </tr>
                        </table>
                        <p>
                            <strong>Completion rate: </strong>
                            <span t-esc="'%.1f%%' % doc.completion_percent"/>
                        </p>
                        <div class="zc-heading">Salesperson summary</div>
                        <table class="zc-table">
                            <thead>
                                <tr>
                                    <th>Salesperson</th>
                                    <th>Customers</th>
                                    <th>Planned</th>
                                    <th>Completed planned</th>
                                    <th>Missed</th>
                                    <th>Pending</th>
                                    <th>In Progress</th>
                                    <th>Overdue</th>
                                    <th>Awaiting Approval</th>
                                    <th>Rejected</th>
                                    <th>Unplanned</th>
                                    <th>Rate %</th>
                                    <th>Distance km</th>
                                    <th>Tracking min</th>
                                    <th>Expense</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="l">
                                    <td t-esc="l.user_id.name"/>
                                    <td t-esc="l.customer_count"/>
                                    <td t-esc="l.planned_visits"/>
                                    <td t-esc="l.completed_visits"/>
                                    <td t-esc="l.missed_visits"/>
                                    <td t-esc="l.pending_visits"/>
                                    <td t-esc="l.in_progress_visits"/>
                                    <td t-esc="l.overdue_visits"/>
                                    <td t-esc="l.awaiting_approval_visits"/>
                                    <td t-esc="l.rejected_visits"/>
                                    <td t-esc="l.unplanned_visits"/>
                                    <td t-esc="'%.1f' % l.completion_percent"/>
                                    <td t-esc="'%.2f' % l.distance_km"/>
                                    <td t-esc="'%.1f' % l.tracking_minutes"/>
                                    <td t-esc="'%.2f' % l.expense"/>
                                </tr>
                            </tbody>
                        </table>
                        <div class="zc-heading">Daily summary</div>
                        <table class="zc-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Planned</th>
                                    <th>Completed planned</th>
                                    <th>Missed</th>
                                    <th>Pending</th>
                                    <th>In Progress</th>
                                    <th>Overdue</th>
                                    <th>Awaiting Approval</th>
                                    <th>Rejected</th>
                                    <th>Unplanned</th>
                                    <th>Distance km</th>
                                    <th>Visit min</th>
                                    <th>Idle min</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.day_line_ids" t-as="d">
                                    <td>
                                        <span t-field="d.date"/>
                                    </td>
                                    <td t-esc="d.planned_visits"/>
                                    <td t-esc="d.completed_visits"/>
                                    <td t-esc="d.missed_visits"/>
                                    <td t-esc="d.pending_visits"/>
                                    <td t-esc="d.in_progress_visits"/>
                                    <td t-esc="d.overdue_visits"/>
                                    <td t-esc="d.awaiting_approval_visits"/>
                                    <td t-esc="d.rejected_visits"/>
                                    <td t-esc="d.unplanned_visits"/>
                                    <td t-esc="'%.2f' % d.distance_km"/>
                                    <td t-esc="'%.1f' % d.visit_minutes"/>
                                    <td t-esc="'%.1f' % d.idle_minutes"/>
                                </tr>
                            </tbody>
                        </table>
                        <div style="page-break-before:always;">
                            <div class="zc-heading">Customer-wise visit register</div>
                            <p t-if="not doc.visit_line_ids">No visits match the selected scope and detail status.</p>
                            <table class="zc-table">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Date</th>
                                        <th>Salesperson</th>
                                        <th>Customer</th>
                                        <th>Planned</th>
                                        <th>Purpose</th>
                                        <th>Status</th>
                                        <th>Check-in</th>
                                        <th>Check-out</th>
                                        <th>Minutes</th>
                                        <th>Outcome</th>
                                        <th>Rating</th>
                                        <th>Explanation / notes</th>
                                        <th>Photo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.visit_line_ids" t-as="v">
                                        <td t-esc="v.reference"/>
                                        <td>
                                            <span t-field="v.visit_date"/>
                                        </td>
                                        <td t-esc="v.user_id.name"/>
                                        <td t-esc="v.partner_id.name"/>
                                        <td t-esc="'Yes' if v.is_planned else 'No'"/>
                                        <td>
                                            <span t-field="v.purpose"/>
                                        </td>
                                        <td t-att-style="'color:#b42318;font-weight:bold' if v.status in ('missed','overdue') else ('color:#087f5b;font-weight:bold' if v.status == 'completed' else '')">
                                            <span t-field="v.status"/>
                                        </td>
                                        <td>
                                            <span t-field="v.checkin_time"/>
                                        </td>
                                        <td>
                                            <span t-field="v.checkout_time"/>
                                        </td>
                                        <td t-esc="'%.1f' % v.duration_minutes"/>
                                        <td>
                                            <span t-field="v.outcome"/>
                                        </td>
                                        <td t-esc="v.rating"/>
                                        <td t-esc="(v.reason or '') + ' | ' + (v.notes or '') + ' | ' + (v.customer_feedback or '')"/>
                                        <td t-esc="'Yes' if v.photo_available else 'No'"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div style="page-break-before:always;">
                            <div class="zc-heading">Missed and overdue visits — follow-up required</div>
                            <p t-if="not doc.missed_line_ids">No missed or overdue visits match the detail filter.</p>
                            <table class="zc-table">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Date</th>
                                        <th>Salesperson</th>
                                        <th>Customer</th>
                                        <th>Planned</th>
                                        <th>Purpose</th>
                                        <th>Status</th>
                                        <th>Check-in</th>
                                        <th>Check-out</th>
                                        <th>Minutes</th>
                                        <th>Outcome</th>
                                        <th>Rating</th>
                                        <th>Explanation / notes</th>
                                        <th>Photo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.missed_line_ids" t-as="v">
                                        <td t-esc="v.reference"/>
                                        <td>
                                            <span t-field="v.visit_date"/>
                                        </td>
                                        <td t-esc="v.user_id.name"/>
                                        <td t-esc="v.partner_id.name"/>
                                        <td t-esc="'Yes' if v.is_planned else 'No'"/>
                                        <td>
                                            <span t-field="v.purpose"/>
                                        </td>
                                        <td t-att-style="'color:#b42318;font-weight:bold' if v.status in ('missed','overdue') else ('color:#087f5b;font-weight:bold' if v.status == 'completed' else '')">
                                            <span t-field="v.status"/>
                                        </td>
                                        <td>
                                            <span t-field="v.checkin_time"/>
                                        </td>
                                        <td>
                                            <span t-field="v.checkout_time"/>
                                        </td>
                                        <td t-esc="'%.1f' % v.duration_minutes"/>
                                        <td>
                                            <span t-field="v.outcome"/>
                                        </td>
                                        <td t-esc="v.rating"/>
                                        <td t-esc="(v.reason or '') + ' | ' + (v.notes or '') + ' | ' + (v.customer_feedback or '')"/>
                                        <td t-esc="'Yes' if v.photo_available else 'No'"/>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="zc-heading">Customer coverage within selected period</div>
                            <div t-field="doc.customer_analysis_html"/>
                            <div class="zc-heading">Travel and expense summary</div>
                            <p>Estimated expenses: <span t-field="doc.total_estimated_expense"/> | Actual expenses: <span t-field="doc.total_expense"/>
                            </p>
                            <table class="zc-table">
                                <thead>
                                    <tr>
                                        <th>Salesperson</th>
                                        <th>Distance km</th>
                                        <th>Tracking min</th>
                                        <th>Visit min</th>
                                        <th>Idle min</th>
                                        <th>Estimated expense</th>
                                        <th>Actual expense</th>
                                        <th>Rating</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.line_ids" t-as="l">
                                        <td t-esc="l.user_id.name"/>
                                        <td t-esc="'%.2f' % l.distance_km"/>
                                        <td t-esc="'%.2f' % l.tracking_minutes"/>
                                        <td t-esc="'%.2f' % l.visit_minutes"/>
                                        <td t-esc="'%.2f' % l.idle_minutes"/>
                                        <td t-esc="'%.2f' % l.estimated_expense"/>
                                        <td t-esc="'%.2f' % l.expense"/>
                                        <td t-esc="'%.2f' % l.average_rating"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
