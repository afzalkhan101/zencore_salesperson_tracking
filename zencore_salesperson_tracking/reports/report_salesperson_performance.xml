<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="paperformat_salesperson_performance" model="report.paperformat">
        <field name="name">Salesperson Performance Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="header_spacing">8</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_salesperson_performance" model="ir.actions.report">
        <field name="name">Salesperson Performance Report</field>
        <field name="model">salesperson.performance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zencore_salesperson_tracking.report_salesperson_performance_document</field>
        <field name="report_file">zencore_salesperson_tracking.report_salesperson_performance_document</field>
        <field name="paperformat_id" ref="paperformat_salesperson_performance"/>
        <field name="print_report_name">'Salesperson Performance - %s to %s' % (object.date_from, object.date_to)</field>
    </record>

    <template id="report_salesperson_performance_document">
        <t t-foreach="docs" t-as="doc">
            <t t-set="company" t-value="env.company"/>
            <t t-call="web.basic_layout">
                    <div class="page zc-performance-report">
                        <style type="text/css">
                            .zc-performance-report { color: #111; font-family: Arial, sans-serif; font-size: 9px; }
                            .zc-performance-report h2 { font-size: 18px; font-weight: 600; margin: 0 0 3px; }
                            .zc-performance-report h3 { font-size: 11px; font-weight: 600; margin: 14px 0 5px; padding-bottom: 3px; border-bottom: 1px solid #222; }
                            .zc-performance-report p { margin: 2px 0; }
                            .zc-meta { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
                            .zc-meta td { vertical-align: top; padding: 2px 4px; }
                            .zc-table { width: 100%; border-collapse: collapse; table-layout: fixed; margin: 0 0 10px; font-size: 8px; }
                            .zc-table thead { display: table-header-group; }
                            .zc-table th { background: #f0f0f0; font-weight: 600; text-align: left; }
                            .zc-table th, .zc-table td { border: 1px solid #888; padding: 4px; vertical-align: top; overflow-wrap: anywhere; }
                            .zc-table tr { page-break-inside: avoid; }
                            .zc-number { text-align: right; white-space: nowrap; }
                            .zc-summary { width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 8px; }
                            .zc-summary td { border: 1px solid #888; padding: 5px; vertical-align: top; }
                            .zc-summary .label { display: block; color: #333; font-size: 8px; }
                            .zc-summary .value { display: block; font-size: 11px; margin-top: 2px; }
                            .zc-note { color: #444; font-size: 8px; }
                            .zc-empty { margin-top: 55mm; text-align: center; }
                            .zc-empty p { font-size: 12px; }
                        </style>

                        <div t-if="not doc.visit_line_ids" class="zc-empty">
                            <h2>No data found</h2>
                            <p>No data was found for the selected report filters.</p>
                        </div>
                        <t t-else="">
                        <table class="zc-meta">
                            <tr>
                                <td style="width: 60%;">
                                    <h2>Salesperson Performance Report</h2>
                                    <p t-esc="company.name"/>
                                </td>
                                <td>
                                    <p>Period: <span t-field="doc.date_from"/> - <span t-field="doc.date_to"/></p>
                                    <p>Salespersons: <span t-esc="doc.individual_user_id.name if doc.report_type == 'individual' else (', '.join(doc.user_ids.mapped('name')) if doc.salesperson_scope == 'selected' else 'All permitted salespersons')"/></p>
                                    <p>Customer: <span t-esc="doc.partner_id.name if doc.customer_scope == 'selected' else 'All customers'"/></p>
                                    <p>Visit status: <span t-field="doc.visit_status"/></p>
                                </td>
                            </tr>
                        </table>

                        <h3>Summary</h3>
                        <table class="zc-summary">
                            <tr>
                                <td><span class="label">Salespersons</span><span class="value" t-esc="doc.total_salespersons"/></td>
                                <td><span class="label">Customers</span><span class="value" t-esc="doc.total_customers"/></td>
                                <td><span class="label">Planned visits</span><span class="value" t-esc="doc.total_planned_visits"/></td>
                                <td><span class="label">Completed visits</span><span class="value" t-esc="doc.total_completed_visits"/></td>
                                <td><span class="label">Remaining visits</span><span class="value" t-esc="doc.total_pending_visits + doc.total_in_progress_visits"/></td>
                                <td><span class="label">Missed / overdue</span><span class="value" t-esc="doc.total_missed_visits + doc.total_overdue_visits"/></td>
                            </tr>
                            <tr>
                                <td><span class="label">Completion rate</span><span class="value" t-esc="'%.1f' % doc.completion_percent"/>%</td>
                                <td><span class="label">Distance (km)</span><span class="value" t-esc="'%.2f' % doc.total_distance_km"/></td>
                                <td><span class="label">Tracking (min)</span><span class="value" t-esc="'%.1f' % doc.total_tracking_minutes"/></td>
                                <td><span class="label">Visit time (min)</span><span class="value" t-esc="'%.1f' % doc.total_visit_minutes"/></td>
                                <td><span class="label">Idle time (min)</span><span class="value" t-esc="'%.1f' % doc.total_idle_minutes"/></td>
                                <td><span class="label">Actual expense</span><span class="value" t-esc="'%.2f' % doc.total_expense"/></td>
                            </tr>
                        </table>

                        <h3>Salesperson summary</h3>
                        <table class="zc-table">
                            <thead>
                                <tr>
                                    <th style="width: 17%;">Salesperson</th>
                                    <th class="zc-number">Customers</th>
                                    <th class="zc-number">Planned</th>
                                    <th class="zc-number">Completed</th>
                                    <th class="zc-number">Remaining</th>
                                    <th class="zc-number">Missed</th>
                                    <th class="zc-number">Rate</th>
                                    <th class="zc-number">Distance km</th>
                                    <th class="zc-number">Tracking min</th>
                                    <th class="zc-number">Visit min</th>
                                    <th class="zc-number">Idle min</th>
                                    <th class="zc-number">Expense</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td t-esc="line.user_id.name"/>
                                    <td class="zc-number" t-esc="line.customer_count"/>
                                    <td class="zc-number" t-esc="line.planned_visits"/>
                                    <td class="zc-number" t-esc="line.completed_visits"/>
                                    <td class="zc-number" t-esc="line.pending_visits + line.in_progress_visits"/>
                                    <td class="zc-number" t-esc="line.missed_visits + line.overdue_visits"/>
                                    <td class="zc-number"><span t-esc="'%.1f' % line.completion_percent"/>%</td>
                                    <td class="zc-number" t-esc="'%.2f' % line.distance_km"/>
                                    <td class="zc-number" t-esc="'%.1f' % line.tracking_minutes"/>
                                    <td class="zc-number" t-esc="'%.1f' % line.visit_minutes"/>
                                    <td class="zc-number" t-esc="'%.1f' % line.idle_minutes"/>
                                    <td class="zc-number" t-esc="'%.2f' % line.expense"/>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Daily summary</h3>
                        <table class="zc-table">
                            <thead>
                                <tr>
                                    <th style="width: 16%;">Date</th>
                                    <th class="zc-number">Planned</th>
                                    <th class="zc-number">Completed</th>
                                    <th class="zc-number">Remaining</th>
                                    <th class="zc-number">Missed</th>
                                    <th class="zc-number">Distance km</th>
                                    <th class="zc-number">Visit min</th>
                                    <th class="zc-number">Idle min</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.day_line_ids" t-as="day">
                                    <td><span t-field="day.date"/></td>
                                    <td class="zc-number" t-esc="day.planned_visits"/>
                                    <td class="zc-number" t-esc="day.completed_visits"/>
                                    <td class="zc-number" t-esc="day.pending_visits + day.in_progress_visits"/>
                                    <td class="zc-number" t-esc="day.missed_visits + day.overdue_visits"/>
                                    <td class="zc-number" t-esc="'%.2f' % day.distance_km"/>
                                    <td class="zc-number" t-esc="'%.1f' % day.visit_minutes"/>
                                    <td class="zc-number" t-esc="'%.1f' % day.idle_minutes"/>
                                </tr>
                            </tbody>
                        </table>

                        <div class="page zc-performance-report">
                            <table class="zc-meta" style="border-bottom: 1px solid #222; padding-bottom: 3px;">
                                <tr>
                                    <td style="width: 60%;">Salesperson Performance Report — Visit details</td>
                                    <td style="text-align: right;"><span t-esc="company.name"/></td>
                                </tr>
                            </table>
                            <h3>Visit details</h3>
                            <p class="zc-note" t-if="not doc.visit_line_ids">No visits match the selected report filters.</p>
                            <table t-if="doc.visit_line_ids" class="zc-table">
                                <thead>
                                    <tr>
                                        <th style="width: 11%;">Reference</th>
                                        <th style="width: 7%;">Date</th>
                                        <th style="width: 11%;">Salesperson</th>
                                        <th style="width: 12%;">Customer</th>
                                        <th style="width: 9%;">Purpose</th>
                                        <th style="width: 8%;">Status</th>
                                        <th style="width: 10%;">Check-in</th>
                                        <th style="width: 10%;">Check-out</th>
                                        <th class="zc-number" style="width: 6%;">Minutes</th>
                                        <th style="width: 16%;">Notes / reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.visit_line_ids" t-as="visit">
                                        <td t-esc="visit.reference"/>
                                        <td><span t-field="visit.visit_date"/></td>
                                        <td t-esc="visit.user_id.name"/>
                                        <td t-esc="visit.partner_id.name"/>
                                        <td><span t-field="visit.purpose"/></td>
                                        <td><span t-field="visit.status"/></td>
                                        <td><span t-field="visit.checkin_time"/></td>
                                        <td><span t-field="visit.checkout_time"/></td>
                                        <td class="zc-number" t-esc="'%.1f' % visit.duration_minutes"/>
                                        <td t-esc="visit.reason or visit.notes or visit.customer_feedback or ''"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        </t>
                    </div>
            </t>
        </t>
    </template>
</odoo>
