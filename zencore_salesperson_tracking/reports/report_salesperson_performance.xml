<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="paperformat_salesperson_performance" model="report.paperformat">
        <field name="name">Salesperson Performance Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_salesperson_performance" model="ir.actions.report">
        <field name="name">Salesperson Performance Report</field>
        <field name="model">salesperson.performance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zencore_salesperson_tracking.report_salesperson_performance_document</field>
        <field name="report_file">zencore_salesperson_tracking.report_salesperson_performance_document</field>
        <field name="paperformat_id" ref="paperformat_salesperson_performance"/>
        <field name="print_report_name">'Salesperson Performance - %s to %s' % (object.date_from, object.date_to)</field>

    </record>

    <template id="report_salesperson_performance_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family:Arial,sans-serif;color:#111;font-size:10px;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid #555;padding:2px 0 7px 0;margin-bottom:10px;">
                        <div>
                            <div style="font-size:16px;font-weight:400;">Salesperson Performance Report</div>
                            <div style="font-size:10px;color:#444;margin-top:2px;">Salesperson Tracking</div>
                        </div>
                        <div style="text-align:right;color:#333;">
                            <div t-esc="env.company.name"/>
                            <div><span t-esc="doc.date_from"/> - <span t-esc="doc.date_to"/></div>
                            <div style="text-transform:capitalize;">Type: <span t-esc="doc.report_type"/></div>
                        </div>
                    </div>

                    <table style="width:100%;border-collapse:collapse;margin-bottom:12px;">
                        <tr>
                            <td style="background:#f5f5f5;padding:5px 6px;border:1px solid #cfcfcf;text-align:center;">Total Salespersons: <span t-esc="doc.total_salespersons"/></td>
                            <td style="background:#f5f5f5;padding:5px 6px;border:1px solid #cfcfcf;text-align:center;">Completed Visits: <span t-esc="doc.total_completed_visits"/></td>
                            <td style="background:#f5f5f5;padding:5px 6px;border:1px solid #cfcfcf;text-align:center;">Pending Visits: <span t-esc="doc.total_pending_visits"/></td>
                            <td style="background:#f5f5f5;padding:5px 6px;border:1px solid #cfcfcf;text-align:center;">Planned Visits: <span t-esc="doc.total_planned_visits"/></td>
                            <td style="background:#f5f5f5;padding:5px 6px;border:1px solid #cfcfcf;text-align:center;">Total Distance: <span t-esc="'%.2f KM' % doc.total_distance_km"/></td>
                        </tr>
                        <tr>
                            <td style="background:#f5f5f5;padding:5px 6px;border:1px solid #cfcfcf;text-align:center;">Tracking Time: <span t-esc="'%.1f h' % (doc.total_tracking_minutes/60.0)"/></td>
                            <td style="background:#f5f5f5;padding:5px 6px;border:1px solid #cfcfcf;text-align:center;">Visit Time: <span t-esc="'%.1f h' % (doc.total_visit_minutes/60.0)"/></td>
                            <td style="background:#f5f5f5;padding:5px 6px;border:1px solid #cfcfcf;text-align:center;">Idle Time: <span t-esc="'%.1f h' % (doc.total_idle_minutes/60.0)"/></td>
                            <td style="background:#f5f5f5;padding:5px 6px;border:1px solid #cfcfcf;text-align:center;">Total Expense: <span t-esc="'%.2f' % doc.total_expense"/></td>
                            <td style="background:#f5f5f5;padding:5px 6px;border:1px solid #cfcfcf;text-align:center;">Completion: <span t-esc="('%.1f' % doc.completion_percent) + '%'"/></td>
                        </tr>
                    </table>

                    <div style="font-size:11px;font-weight:400;border-bottom:1px solid #777;padding:4px 0;margin:10px 0 0;">Salesperson Performance Summary</div>
                    <table style="width:100%;border-collapse:collapse;margin-bottom:14px;">
                        <thead>
                            <tr style="background:#f0f0f0;font-weight:400;">
                                <th style="padding:5px;border:1px solid #c8c8c8;text-align:left;font-weight:400;">Salesperson</th>
                                <th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Planned</th>
                                <th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Completed</th>
                                <th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Pending</th>
                                <th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Completion %</th>
                                <th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Distance</th>
                                <th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Visit Time</th>
                                <th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Idle Time</th>
                                <th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Expense</th>
                                <th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Rating</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.line_ids" t-as="line">
                                <td style="padding:6px;border:1px solid #dedede;" t-esc="line.user_id.name"/>
                                <td style="padding:6px;border:1px solid #dedede;text-align:center;" t-esc="line.planned_visits"/>
                                <td style="padding:6px;border:1px solid #dedede;text-align:center;" t-esc="line.completed_visits"/>
                                <td style="padding:6px;border:1px solid #dedede;text-align:center;" t-esc="line.pending_visits"/>
                                <td style="padding:6px;border:1px solid #dedede;text-align:center;" t-esc="('%.1f' % line.completion_percent) + '%'"/>
                                <td style="padding:6px;border:1px solid #dedede;text-align:right;" t-esc="'%.2f' % line.distance_km"/>
                                <td style="padding:6px;border:1px solid #dedede;text-align:right;" t-esc="'%.1f h' % (line.visit_minutes/60.0)"/>
                                <td style="padding:6px;border:1px solid #dedede;text-align:right;" t-esc="'%.1f h' % (line.idle_minutes/60.0)"/>
                                <td style="padding:6px;border:1px solid #dedede;text-align:right;" t-esc="'%.2f' % line.expense"/>
                                <td style="padding:6px;border:1px solid #dedede;text-align:center;" t-esc="'%.1f' % line.average_rating"/>
                            </tr>
                        </tbody>
                    </table>

                    <t t-if="doc.day_line_ids">
                        <div style="font-size:11px;font-weight:400;border-bottom:1px solid #777;padding:4px 0;margin:10px 0 0;">Day-wise Summary</div>
                        <table style="width:100%;border-collapse:collapse;margin-bottom:14px;">
                            <thead><tr style="background:#f0f0f0;font-weight:400;">
                                <th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Date</th><th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Planned</th><th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Completed</th><th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Pending</th><th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Distance KM</th><th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Visit Time</th><th style="padding:5px;border:1px solid #c8c8c8;font-weight:400;">Idle Time</th>
                            </tr></thead>
                            <tbody><tr t-foreach="doc.day_line_ids" t-as="d">
                                <td style="padding:5px;border:1px solid #dedede;" t-esc="d.date"/><td style="padding:5px;border:1px solid #dedede;text-align:center;" t-esc="d.planned_visits"/><td style="padding:5px;border:1px solid #dedede;text-align:center;" t-esc="d.completed_visits"/><td style="padding:5px;border:1px solid #dedede;text-align:center;" t-esc="d.pending_visits"/><td style="padding:5px;border:1px solid #dedede;text-align:right;" t-esc="'%.2f' % d.distance_km"/><td style="padding:5px;border:1px solid #dedede;text-align:right;" t-esc="'%.1f h' % (d.visit_minutes/60.0)"/><td style="padding:5px;border:1px solid #dedede;text-align:right;" t-esc="'%.1f h' % (d.idle_minutes/60.0)"/>
                            </tr></tbody>
                        </table>
                    </t>

                    <t t-if="doc.visit_line_ids">
                        <div style="page-break-before:always;"/>
                        <div style="font-size:11px;font-weight:400;border-bottom:1px solid #777;padding:4px 0;margin:10px 0 0;">Visit Details</div>
                        <table style="width:100%;border-collapse:collapse;font-size:9px;">
                            <thead><tr style="background:#f0f0f0;font-weight:400;">
                                <th style="padding:4px;border:1px solid #c8c8c8;font-weight:400;">Date</th><th style="padding:4px;border:1px solid #c8c8c8;font-weight:400;">Salesperson</th><th style="padding:4px;border:1px solid #c8c8c8;font-weight:400;">Customer</th><th style="padding:4px;border:1px solid #c8c8c8;font-weight:400;">Purpose</th><th style="padding:4px;border:1px solid #c8c8c8;font-weight:400;">Check In</th><th style="padding:4px;border:1px solid #c8c8c8;font-weight:400;">Check Out</th><th style="padding:4px;border:1px solid #c8c8c8;font-weight:400;">Duration</th><th style="padding:4px;border:1px solid #c8c8c8;font-weight:400;">Status</th><th style="padding:4px;border:1px solid #c8c8c8;font-weight:400;">Rating</th>
                            </tr></thead>
                            <tbody><tr t-foreach="doc.visit_line_ids" t-as="v">
                                <td style="padding:4px;border:1px solid #dedede;" t-esc="v.visit_date"/><td style="padding:4px;border:1px solid #dedede;" t-esc="v.user_id.name"/><td style="padding:4px;border:1px solid #dedede;" t-esc="v.partner_id.name"/><td style="padding:4px;border:1px solid #dedede;" t-esc="v.purpose or '-'"/><td style="padding:4px;border:1px solid #dedede;" t-esc="v.checkin_time or '-'"/><td style="padding:4px;border:1px solid #dedede;" t-esc="v.checkout_time or '-'"/><td style="padding:4px;border:1px solid #dedede;text-align:right;" t-esc="'%.0f min' % v.duration_minutes"/><td style="padding:4px;border:1px solid #dedede;text-align:center;" t-esc="v.status or '-'"/><td style="padding:4px;border:1px solid #dedede;text-align:center;" t-esc="'%.1f' % v.rating"/>
                            </tr></tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
