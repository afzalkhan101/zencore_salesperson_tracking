<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_customer_detailed_report" model="report.paperformat">
        <field name="name">Customer Visit Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_customer_detailed" model="ir.actions.report">
        <field name="name">Customer Visit Report</field>
        <field name="model">salesperson.customer.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zencore_salesperson_tracking.report_customer_detailed_document</field>
        <field name="report_file">zencore_salesperson_tracking.report_customer_detailed_document</field>
        <field name="paperformat_id" ref="paperformat_customer_detailed_report"/>
        <field name="print_report_name">'Customer Visit Report - %s to %s' % (object.date_from, object.date_to)</field>
    </record>

    <template id="report_customer_detailed_document">
        <t t-foreach="docs" t-as="doc">
            <t t-set="company" t-value="env.company"/>
            <t t-call="web.basic_layout">
                <div class="page zc-customer-report">
                    <style type="text/css">
                        .zc-customer-report { color:#111; font-family:Arial, sans-serif; font-size:9px; }
                        .zc-customer-report h2 { font-size:18px; font-weight:600; margin:0 0 3px; }
                        .zc-customer-report h3 { font-size:11px; font-weight:600; margin:14px 0 5px; padding-bottom:3px; border-bottom:1px solid #222; }
                        .zc-customer-report p { margin:2px 0; }
                        .zc-meta,.zc-summary,.zc-table { width:100%; border-collapse:collapse; table-layout:fixed; }
                        .zc-meta { margin-bottom:10px; }
                        .zc-meta td { vertical-align:top; padding:2px 4px; }
                        .zc-summary { margin-bottom:8px; }
                        .zc-summary td { border:1px solid #888; padding:5px; vertical-align:top; }
                        .zc-summary .label { display:block; color:#333; font-size:8px; }
                        .zc-summary .value { display:block; font-size:11px; margin-top:2px; }
                        .zc-table { margin:0 0 10px; font-size:8px; }
                        .zc-table thead { display:table-header-group; }
                        .zc-table th { background:#f0f0f0; font-weight:600; text-align:left; }
                        .zc-table th,.zc-table td { border:1px solid #888; padding:4px; vertical-align:top; overflow-wrap:anywhere; }
                        .zc-table tr { page-break-inside:avoid; }
                        .zc-number { text-align:right; white-space:nowrap; }
                        .zc-note { color:#444; font-size:8px; }
                        .zc-empty { margin-top:55mm; text-align:center; }
                        .zc-empty p { font-size:12px; }
                    </style>

                    <div t-if="not doc.line_ids" class="zc-empty">
                        <h2>No data found</h2>
                        <p>No customer visits match the selected report filters.</p>
                    </div>
                    <t t-else="">
                        <table class="zc-meta">
                            <tr>
                                <td style="width:60%;">
                                    <h2>Customer Visit Report</h2>
                                    <p t-esc="company.name"/>
                                </td>
                                <td>
                                    <p>Period: <span t-field="doc.date_from"/> - <span t-field="doc.date_to"/></p>
                                    <p>Salespersons: <span t-esc="doc.individual_user_id.name if doc.report_type == 'individual' else (', '.join(doc.user_ids.mapped('name')) if doc.salesperson_scope == 'selected' else 'All permitted salespersons')"/></p>
                                    <p>Customer: <span t-esc="doc.partner_id.name if doc.customer_scope == 'selected' else 'All customers'"/></p>
                                    <p>Visit status: <span t-field="doc.visit_status"/></p>
                                </td>
                            </tr>
                        </table>

                        <h3>Summary</h3>
                        <table class="zc-summary">
                            <tr>
                                <td><span class="label">Customers</span><span class="value" t-esc="doc.total_customers"/></td>
                                <td><span class="label">Salespersons</span><span class="value" t-esc="doc.total_salespersons"/></td>
                                <td><span class="label">Planned visits</span><span class="value" t-esc="doc.total_visits"/></td>
                                <td><span class="label">Completed visits</span><span class="value" t-esc="doc.completed_visits"/></td>
                                <td><span class="label">Remaining visits</span><span class="value" t-esc="doc.pending_visits + doc.in_progress_visits"/></td>
                                <td><span class="label">Missed / overdue</span><span class="value" t-esc="doc.missed_visits"/></td>
                            </tr>
                            <tr>
                                <td><span class="label">Completion rate</span><span class="value"><span t-esc="'%.1f' % doc.completion_percent"/>%</span></td>
                                <td><span class="label">Distance (km)</span><span class="value" t-esc="'%.2f' % doc.total_distance_km"/></td>
                                <td><span class="label">Tracking time</span><span class="value" t-esc="'%d h %d min' % (int(doc.total_tracking_minutes) // 60, int(doc.total_tracking_minutes) % 60)"/></td>
                                <td><span class="label">Visit time</span><span class="value" t-esc="'%d h %d min' % (int(doc.total_visit_minutes) // 60, int(doc.total_visit_minutes) % 60)"/></td>
                                <td><span class="label">Idle time</span><span class="value" t-esc="'%d h %d min' % (int(doc.total_idle_minutes) // 60, int(doc.total_idle_minutes) % 60)"/></td>
                                <td><span class="label">Actual expense</span><span class="value" t-esc="'%.2f' % doc.total_expense"/></td>
                            </tr>
                        </table>

                        <h3>Customer summary</h3>
                        <table class="zc-table">
                            <thead><tr>
                                <th style="width:22%;">Customer</th><th class="zc-number">Salespeople</th><th class="zc-number">Planned</th><th class="zc-number">Completed</th><th class="zc-number">Remaining</th><th class="zc-number">Missed</th><th class="zc-number">Rate</th><th class="zc-number">Distance km</th><th class="zc-number">Visit time</th><th>Last completed visit</th>
                            </tr></thead>
                            <tbody><tr t-foreach="doc.customer_line_ids" t-as="line">
                                <td t-esc="line.partner_id.name"/><td class="zc-number" t-esc="line.salesperson_count"/><td class="zc-number" t-esc="line.planned"/><td class="zc-number" t-esc="line.completed"/><td class="zc-number" t-esc="line.pending + line.in_progress"/><td class="zc-number" t-esc="line.missed"/><td class="zc-number"><span t-esc="'%.1f' % line.completion_percent"/>%</td><td class="zc-number" t-esc="'%.2f' % line.distance_km"/><td class="zc-number" t-esc="'%d h %d min' % (int(line.visit_minutes) // 60, int(line.visit_minutes) % 60)"/><td><span t-field="line.last_visit_date"/></td>
                            </tr></tbody>
                        </table>

                        <h3>Daily summary</h3>
                        <table class="zc-table">
                            <thead><tr><th style="width:18%;">Date</th><th class="zc-number">Planned</th><th class="zc-number">Completed</th><th class="zc-number">Remaining</th><th class="zc-number">Missed</th><th class="zc-number">Rate</th><th class="zc-number">Distance km</th><th class="zc-number">Visit time</th></tr></thead>
                            <tbody><tr t-foreach="doc.day_line_ids" t-as="line"><td><span t-field="line.date"/></td><td class="zc-number" t-esc="line.planned"/><td class="zc-number" t-esc="line.completed"/><td class="zc-number" t-esc="line.pending + line.in_progress"/><td class="zc-number" t-esc="line.missed"/><td class="zc-number"><span t-esc="'%.1f' % line.completion_percent"/>%</td><td class="zc-number" t-esc="'%.2f' % line.distance_km"/><td class="zc-number" t-esc="'%d h %d min' % (int(line.visit_minutes) // 60, int(line.visit_minutes) % 60)"/></tr></tbody>
                        </table>

                        <div class="page zc-customer-report">
                            <table class="zc-meta" style="border-bottom:1px solid #222; padding-bottom:3px;"><tr><td style="width:60%;">Customer Visit Report — Visit details</td><td style="text-align:right;" t-esc="company.name"/></tr></table>
                            <h3>Visit details</h3>
                            <table class="zc-table">
                                <thead><tr><th style="width:11%;">Reference</th><th style="width:7%;">Date</th><th style="width:11%;">Salesperson</th><th style="width:12%;">Customer</th><th style="width:9%;">Purpose</th><th style="width:8%;">Status</th><th style="width:10%;">Check-in</th><th style="width:10%;">Check-out</th><th class="zc-number" style="width:8%;">Duration</th><th style="width:14%;">Notes / reason</th></tr></thead>
                                <tbody><tr t-foreach="doc.line_ids" t-as="line"><td t-esc="line.visit_plan_ref"/><td><span t-field="line.visit_date"/></td><td t-esc="line.user_id.name"/><td t-esc="line.partner_id.name"/><td><span t-field="line.purpose"/></td><td><span t-field="line.status"/></td><td><span t-field="line.checkin_time"/></td><td><span t-field="line.checkout_time"/></td><td class="zc-number" t-esc="'%d h %d min' % (int(line.duration_minutes) // 60, int(line.duration_minutes) % 60)"/><td t-esc="line.reason or line.notes or line.customer_feedback or ''"/></tr></tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
