<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_recompute_idle_time" model="ir.cron">
            <field name="name">Recompute Salesperson Idle Time</field>
            <field name="model_id" ref="zencore_salesperson_tracking.model_salesperson_tracker"/>
            <field name="state">code</field>
            <field name="code">model._cron_recompute_idle_time()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
